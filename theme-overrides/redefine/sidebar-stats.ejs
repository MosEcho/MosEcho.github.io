<%
  const archiveMonths = {};
  site.posts.forEach(post => {
    const key = post.date.format('YYYY/MM');
    archiveMonths[key] = (archiveMonths[key] || 0) + 1;
  });
  const startDate = config.mosecho_site_start;
  const creationMonth = new Intl.DateTimeFormat('zh-CN', { year: 'numeric', month: 'long', timeZone: 'Asia/Shanghai' }).format(new Date(startDate));
%>
<section class="sidebar-content me-site-stats" marginTop aria-labelledby="mosecho-stats-title">
  <h2 id="mosecho-stats-title"><i class="fa-regular fa-chart-simple" aria-hidden="true"></i>站点统计</h2>
  <nav class="me-site-stats__tags" aria-label="文章标签">
    <% site.tags.sort('name').forEach(tag => { %>
      <a href="<%= url_for(tag.path) %>" title="<%= tag.name %>：<%= tag.posts.length %> 篇"><%= tag.name %><sup><%= tag.posts.length %></sup></a>
    <% }); %>
  </nav>
  <nav class="me-site-stats__months" aria-label="按月归档（原文发表月份）">
    <% Object.keys(archiveMonths).sort().reverse().forEach(month => {
      const [year, number] = month.split('/');
    %>
      <a href="<%= url_for(config.archive_dir + '/' + month + '/') %>">
        <span><%= Number(number) %>月 <%= year %></span>
        <strong><%= archiveMonths[month] %><small>篇</small></strong>
      </a>
    <% }); %>
  </nav>
  <dl class="me-site-stats__totals">
    <div><dt><i class="fa-regular fa-file-lines" aria-hidden="true"></i>文章总数</dt><dd><%= site.posts.length %></dd></div>
    <div><dt><i class="fa-regular fa-clock" aria-hidden="true"></i>创建时间</dt><dd><%= creationMonth %></dd></div>
    <div><dt><i class="fa-regular fa-users" aria-hidden="true"></i>总访客数</dt><dd id="vercount_value_site_uv" title="访客统计加载中，网络不可用时显示 —">—</dd></div>
    <div><dt><i class="fa-regular fa-chart-column" aria-hidden="true"></i>总访问量</dt><dd id="vercount_value_site_pv" title="访问统计加载中，网络不可用时显示 —">—</dd></div>
  </dl>
  <p class="me-site-stats__credit">访问统计 · <a href="https://vercount.one/" target="_blank" rel="noopener noreferrer">Vercount</a></p>
</section>
